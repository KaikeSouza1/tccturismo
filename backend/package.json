{
  "name": "turismo-local-backend",
  "version": "1.0.0",
  "description": "API RESTful do sistema de registro, gamificacao e valorizacao de visitas a atrativos turisticos",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
